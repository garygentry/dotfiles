# ~/.config/mise/conf.d/dotfiles.toml
# Managed by dotfiles (mise module): rendered from modules.mise.tools / .settings and
# re-rendered on every install, so edit your dotfiles config, not this file. Your own
# global tools belong in ~/.config/mise/config.toml, which dotfiles never touches.
{{- /* Values are typed in YAML; branch on the Go type so TOML gets quoted strings,
       bare booleans/numbers and arrays of strings. */}}

[tools]
{{- range $name, $ver := .Module.tools }}
{{ printf "%q" $name }} = {{ printf "%q" (printf "%v" $ver) }}
{{- end }}

[settings]
{{- range $key, $val := .Module.settings }}
{{- $t := printf "%T" $val }}
{{ $key }} = {{ if eq $t "string" }}{{ printf "%q" $val }}{{ else if eq $t "[]interface {}" }}[{{ range $i, $e := $val }}{{ if $i }}, {{ end }}{{ printf "%q" (printf "%v" $e) }}{{ end }}]{{ else }}{{ $val }}{{ end }}
{{- end }}
