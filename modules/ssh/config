# SSH Configuration
# Managed by dotfiles - {{ .OS }}/{{ .Arch }}
{{- $agent := eq (index .Env "DOTFILES_SSH_KEY_SOURCE") "agent" }}
{{- $keyType := or (index .Env "DOTFILES_SSH_KEY_TYPE") "ed25519" }}

Host *
    # Add keys to the SSH agent automatically
    AddKeysToAgent yes
{{- if eq .OS "darwin" }}

    # Use the macOS Keychain on macOS
    UseKeychain yes
{{- end }}
{{- if not $agent }}

    # Default identity file
{{- if eq $keyType "rsa" }}
    IdentityFile ~/.ssh/id_rsa
{{- else }}
    IdentityFile ~/.ssh/id_{{ $keyType }}
{{- end }}
{{- end }}

    # Connection settings
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ConnectTimeout 10

    # Security settings
    HashKnownHosts yes
    VisualHostKey no

# GitHub
Host github.com
    HostName github.com
    User git
{{- if $agent }}
    # key_source=agent: keys are provided by the SSH agent (e.g. 1Password).
    # No IdentityFile / IdentitiesOnly is set so the agent's keys are offered.
{{- else }}
    IdentityFile {{ or (index .Env "DOTFILES_SSH_GITHUB_KEY") "~/.ssh/id_ed25519" }}
    IdentitiesOnly yes
{{- end }}
