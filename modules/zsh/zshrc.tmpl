{{- /* Template variables from prompt answers */ -}}
{{- $framework := default (index .Env "DOTFILES_PROMPT_ZSH_FRAMEWORK") "zinit" -}}
{{- $omzPlugins := default (index .Env "DOTFILES_PROMPT_ZSH_OMZ_PLUGINS") "standard" -}}
{{- $prompt := default (index .Env "DOTFILES_PROMPT_ZSH_PROMPT") "starship" -}}
# ~/.zshrc - Zsh Configuration
# Managed by dotfiles (framework: {{ $framework }})
{{ if eq $framework "ohmyzsh" }}
# =============================================================================
# Oh My Zsh
# =============================================================================

export ZSH="${HOME}/.oh-my-zsh"

{{ if eq $prompt "starship" -}}
# Prompt handled by Starship (disable Oh My Zsh theme)
ZSH_THEME=""
{{ else -}}
ZSH_THEME="{{ $prompt }}"
{{ end -}}

# Plugins
{{ if eq $omzPlugins "minimal" -}}
plugins=(git z)
{{ else if eq $omzPlugins "full" -}}
plugins=(git z docker colored-man-pages command-not-found sudo extract history aliases web-search)
{{ else -}}
plugins=(git z docker colored-man-pages command-not-found)
{{ end }}
# Disable automatic updates (managed by dotfiles)
zstyle ':omz:update' mode disabled

source "${ZSH}/oh-my-zsh.sh"
{{ else }}
# =============================================================================
# Zinit Plugin Manager
# =============================================================================

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Auto-install zinit if missing
if [[ ! -d "$ZINIT_HOME" ]]; then
    print -P "%F{33}Installing Zinit...%f"
    mkdir -p "$(dirname $ZINIT_HOME)"
    git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Remove any conflicting 'zi' alias (e.g., from Oh My Zsh zeus plugin)
unalias zi 2>/dev/null

source "${ZINIT_HOME}/zinit.zsh"
# Zinit sets 'alias zi=zinit'; remove it so Zinit can define zi() as a
# function during cdreplay without the alias conflicting
unalias zi 2>/dev/null

# =============================================================================
# Plugins (loaded via Zinit)
# =============================================================================

# Additional completions: added to fpath only (blockf), before compinit runs.
zinit ice blockf
zinit light zsh-users/zsh-completions

# Load completions from a cached dump. A full compinit (security audit + dump
# rewrite) costs ~300ms per shell; with -C it trusts the dump and costs a few ms.
# The dump is rebuilt when missing or older than 24h, so newly installed
# completions appear within a day (or at once: rm "$_zcompdump"; exec zsh).
# A full compinit only rewrites the dump when the completion set changed, so the
# dump is touched after it: otherwise, once 24h old, every shell would stay on
# the slow path.
# One dump per zsh version: dumps are not portable across versions.
autoload -Uz compinit
zmodload -F zsh/stat b:zstat
zmodload zsh/datetime
_zcompdump="${XDG_CACHE_HOME:-${HOME}/.cache}/zsh/zcompdump-${ZSH_VERSION}"
[[ -d "${_zcompdump:h}" ]] || mkdir -p "${_zcompdump:h}"
_zcompdump_mtime=0
[[ -f "$_zcompdump" ]] && zstat -A _zcompdump_mtime +mtime -- "$_zcompdump" 2>/dev/null
if (( EPOCHSECONDS - _zcompdump_mtime < 86400 )); then
    compinit -C -d "$_zcompdump"
else
    compinit -d "$_zcompdump"
    command touch -- "$_zcompdump"  # restart the 24h window (runs at most once a day)
fi
unset _zcompdump_mtime
zinit cdreplay -q

# Deferred until just after the first prompt (turbo mode) so they add nothing to
# startup. Order matters: syntax highlighting loads LAST, after every other ZLE
# widget (including any bound in ~/.zshrc.local) exists, or it cannot wrap them.
zinit wait lucid light-mode for \
    atload"_zsh_autosuggest_start" \
        zsh-users/zsh-autosuggestions \
    zsh-users/zsh-syntax-highlighting
{{ end }}
# =============================================================================
# Completion Settings
# =============================================================================

# Inline completion: complete common prefix, list matches on ambiguity (no menu)
zstyle -d ':completion:*' menu
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'  # Case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"   # Colored completions
zstyle ':completion:*' special-dirs true                   # Complete . and ..
unsetopt MENU_COMPLETE         # Don't auto-insert first match
setopt COMPLETE_IN_WORD        # Complete from cursor position
setopt ALWAYS_TO_END           # Move cursor to end after completion
# =============================================================================
# History Configuration
# =============================================================================

HISTFILE="${HOME}/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt EXTENDED_HISTORY        # Record timestamp and duration of each command
setopt SHARE_HISTORY           # Share history between sessions (implies incremental append)
setopt HIST_EXPIRE_DUPS_FIRST  # When trimming, drop duplicates before unique entries
setopt HIST_IGNORE_DUPS        # Ignore consecutive duplicates
setopt HIST_IGNORE_ALL_DUPS    # Remove older duplicate entries
setopt HIST_FIND_NO_DUPS       # Do not display duplicates when searching
setopt HIST_REDUCE_BLANKS      # Remove blank lines from history
setopt HIST_IGNORE_SPACE       # Ignore commands starting with space
setopt HIST_VERIFY             # Show command before executing from history

# =============================================================================
# Shell Options
# =============================================================================

setopt AUTO_CD                 # cd by typing directory name
setopt AUTO_PUSHD              # Push directories onto stack
setopt PUSHD_IGNORE_DUPS       # No duplicate directories in stack
setopt PUSHD_SILENT            # Don't print directory stack
setopt INTERACTIVE_COMMENTS    # Allow comments in interactive shell
setopt NO_BEEP                 # Disable beep

# =============================================================================
# Key Bindings
# =============================================================================

bindkey -e                     # Emacs key bindings
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# =============================================================================
# Path Configuration
# =============================================================================

# The user bin dirs are also set in a managed block in ~/.zshenv, which every
# zsh reads (including non-interactive `ssh host cmd` and agent tool shells).
# They are repeated here because macOS's /etc/zprofile (path_helper) reorders
# PATH after ~/.zshenv runs; this block restores the intended precedence.
typeset -U path                # Deduplicate PATH entries

path=(
    "${HOME}/.local/bin"
    "${HOME}/bin"
    "/usr/local/bin"
    "${DOTFILES_DIR:-$HOME/.dotfiles}/bin"
    # Standard system dirs, listed explicitly so they are present even when
    # /etc/profile is not sourced (e.g. zsh as root on Proxmox, where the
    # sbin dirs hold the admin commands). typeset -U above dedupes, so the
    # /usr/local/bin repeat above keeps its original leading position.
    "/usr/local/sbin"
    "/usr/local/bin"
    "/usr/sbin"
    "/usr/bin"
    "/sbin"
    "/bin"
    $path
)

# =============================================================================
# Source Additional Configuration
# =============================================================================

# Source aliases if the file exists
[[ -f "${HOME}/.config/zsh/aliases.zsh" ]] && source "${HOME}/.config/zsh/aliases.zsh"

# Source custom functions if the file exists
[[ -f "${HOME}/.config/zsh/functions.zsh" ]] && source "${HOME}/.config/zsh/functions.zsh"
{{ if or (eq $framework "zinit") (eq $prompt "starship") }}
# Starship prompt
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
else
    # Fallback prompt: makes it obvious zsh is active when Starship isn't installed
    PROMPT='%F{#cba6f7}%n%f@%F{#89b4fa}%m%f %F{#a6e3a1}%~%f %# '
fi
{{ end }}
# zoxide (smarter cd)
if command -v zoxide &>/dev/null; then
    # Remove any conflicting 'z' alias (e.g., from rupa/z or OMZ z plugin)
    unalias z 2>/dev/null
    eval "$(zoxide init zsh)"
{{ if eq $framework "zinit" -}}
    # zoxide replaces zi() with interactive cd; restore Zinit's zi command
    function zi() { zinit "$@"; }
{{ end -}}
fi

# fzf key bindings (Ctrl-T files, Ctrl-R history, Alt-C cd) and ** completion.
# fzf >= 0.48 emits its own integration via `fzf --zsh`; older packaged builds
# (e.g. Ubuntu 22.04's 0.29) reject that flag, so fall back to the scripts
# shipped by the SAME install as the binary on PATH. Scripts from a different
# fzf version pass flags the binary doesn't know and break the widgets. Minimized
# Ubuntu images drop /usr/share/doc, so an old apt fzf there gets no bindings;
# install a current fzf instead. Skipped unless a line editor will be used: not
# for `zsh -i -c cmd` (as agent tools and scripts run; zsh sets ZSH_EXECUTION_STRING
# only then) and not without a terminal on stdin. fzf's option restore errors in
# both ("can't change option: zle").
if [[ -z "${ZSH_EXECUTION_STRING:-}" && -t 0 ]] && (( $+commands[fzf] )); then
    if _fzf_zsh="$(fzf --zsh 2>/dev/null)"; then
        eval "$_fzf_zsh"
    else
        _fzf_bin="${commands[fzf]:A}"
        case "$_fzf_bin" in
            "${HOME}/.fzf/"*) _fzf_dirs=("${HOME}/.fzf/shell") ;;
            *) _fzf_dirs=(/usr/share/doc/fzf/examples /usr/share/fzf "${_fzf_bin:h:h}/shell") ;;
        esac
        for _fzf_dir in "${_fzf_dirs[@]}"; do
            if [[ -f "${_fzf_dir}/key-bindings.zsh" ]]; then
                source "${_fzf_dir}/key-bindings.zsh"
                [[ -f "${_fzf_dir}/completion.zsh" ]] && source "${_fzf_dir}/completion.zsh"
                break
            fi
        done
        unset _fzf_bin _fzf_dirs _fzf_dir
    fi
    unset _fzf_zsh
fi

# Source local overrides (not managed by dotfiles). An if-block, not `[[ ]] &&`,
# so a missing file doesn't leave $? = 1 as the rc's final status: `zsh -i -c exit`
# (and any `zsh -i -c cmd` that inherits it) would otherwise report failure.
if [[ -f "${HOME}/.zshrc.local" ]]; then
    source "${HOME}/.zshrc.local"
fi
